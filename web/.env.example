# Shopify store, without https://
SHOPIFY_STORE_DOMAIN=priya-metal-mart-suzztm6z.myshopify.com
# Headless channel > storefront > Storefront API > Public access token.
# This token is public by design (it ships to browsers). Never put the private token here.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Launch settings. Leave as is until the real domain is connected.
SITE_URL=https://priyametalmart.pages.dev
SITE_INDEXABLE=false
