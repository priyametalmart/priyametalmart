{
  "name": "priyametalmart-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "sync": "node scripts/sync-shopify.mjs",
    "predev": "npm run sync",
    "dev": "next dev -p 3000",
    "prebuild": "npm run sync",
    "build": "next build",
    "serve": "npx --yes serve out -l 3000",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy out --project-name priyametalmart --branch main"
  },
  "dependencies": {
    "@fontsource-variable/anek-latin": "^5",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
